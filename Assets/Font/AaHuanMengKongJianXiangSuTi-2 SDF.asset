    characterSequence: "\u7C89\u4E1D\u4F1A\u5458\u7B49\u7EA7\u5269\u4F59\u70B9\u6570\u57FA\u7840\u4EF7\u503C\u6BCF\u7EA7\u63D0\u5347\u66B4\u51FB\u500D\u7387\u6D88\u8017\u662F\u5426\u91CD\u5F00\u52A0\u548C\u5C06\u4FDD\u7559\u7279\u6B8A\u793C\u7269\u8D21\u732E\u6211\r\nABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789~`!@#$%^&*()-_=+[]{};:'\",<.>/?\\|
      \xB7\uFF5E\uFF01\uFFE5\u2026\uFF08\uFF09\u2014\u3010\u3011\u300E\u300F\u300C\u300D''\"\"\uFF0C\u3001\u3002\u300A\u300B\uFF1F\uFF1A\uFF1B\u3001\r\n\u4E00\u73A9\u5BB6\u70ED\u5FC3\u8FBE\u4EBA\u6B22\u4E50\u4F7F\u8005\u65B0\u624B\u4E0A\u8DEF\u8D44\u6DF1\u5FEB\u4E50\u661F\u7403\u8FF7\u5F00\u5FC3\u679C\u5192\u9669\u8D85\u7EA7\u9AD8\u624B\u63A2\u7D22\u4F11\u95F2\u8FD9\u4E2A\u6E38\u620F\u7684\u592A\u6682\u597D\u4E86\u753B\u9762\u975E\u5E38\u7CBE\u7F8E\u8D77\u6765\u6D41\u7545\u8BBE\u8BA1\u6709\u521B\u610F\u671F\u5F85\u540E\u7EED\u66F4\u65B0\u64CD\u4F5C\u7B80\u5355\u6613\u9002\u5408\u97F3\u6548\u68D2\u6C1B\u56F4\u611F\u5341\u8DB3\u5173\u5361\u5DE7\u5999\u4F53\u9A8C\u4E0D\u9519\u6CD5\u5F88\u8DA3\u8BA9\u4EBA\u6B32\u7F62\u80FD\u5E0C\u671B\u591A\u52A0\u4E9B\u5185\u5BB9\u8282\u594F\u628A\u63E1\u72EC\u7279\u5438\u5F15\u6545\u4E8B\u60C5\u8282\u5F3A\u8FC7\u763E\u5236\u4F5C\u7528\u5FC3\u503C\u5F97\u63A8\u8350\u4F18\u5316\u7F8E\u672F\u98CE\u683C\u8D5E\u521B\u65B0\u9C9C\u96BE\u5EA6\u9002\u4E2D\u6311\u6218\u6027\u5E26\u6C89\u6D78\u4E30\u5BCC\u6837\u505A\u5973\u795E\u7231\u4F60\u53C8\u59CB\u5356\u60E8\u5267\u672C\u4ECA\u5929\u5565\u6362\u6EE4\u955C\u884C\u90FD\u7CCA\u6210\u9B3C\u5F71\u8BF4\u5B9E\u8BDD\u989C\u653E\u73B0\u6253\u51E0\u5206\u89C9\u76F4\u64AD\u5C31\u5728\u8D4F\u6574\u88C5\u53EF\u601C\u771F\u7D2F\u667A\u5546\u95E8\u69DB\u5417\u522B\u6F14\u8001\u80CC\u7A3F\u5986\u8272\u53F7\u8138\u8DDF\u8116\u5B50\u4FE9\u7EBF\u89D2\u699C\u8F6E\u201C\u7F18\u201D\u6492\u5A07\u82B1\u817B\u4E5F\u4E3A\u52A8\u60F3\u5F53\u53EA\u91CC\u552F\u5168\u5E73\u53F0\u6700\u5BA0\u4E3B\u6CA1\u4E4B\u770B\u95F9\u8981\u51FA\u4E0B\u51B2\u7B2C\u6392\u53D1\u8A93\u8F88\u5145\u591F\u79BB\u8C31\u60DC\u77E5\u9053\u52FE\u7FFB\u8F66\u50CF\u8BF6\u58F0\u542C\u957F\u561B\u633A\u5148\u7B11\u79D2\u949F\u51B7\u9759\u578B\u7535\u6247\u67B6\u8F93\u521A\u5230\u72AF\u75C5\u8A00\u526A\u6296\u7D20\u6750\u534A\u5E74\u4EE5\u6291\u90C1\u7ACB\u523B\u7F13\u89E3\u6000\u7591\u6D3B\u6643\u673A\u6655\u5C0F\u4F46\u73ED\u540D\u8F6F\u5976\u51F6\u5965\u66FC\u8FFD\u8336\u5151\u6BD2\u836F\u5403\u9999\u83DC\u952E\u76D8\u54CD\u8FCE\u95F4\u4EEC\u5143\u6C14\u6EE1\u5462\u4F19\u4F34\u8BB0\u6CE8\u54E6\u5F69\u5566\u5927\u9001\u9501\u4E13\u5C5E\u798F\u5229\u8C01\u54E5\u54C7\u8C22\u4F6C\u5DF2\u7ECF\u94C1\u54DF\u652F\u6301\u6B63\u5F0F\u5BA3\u5E03\u665A\u2665\u6708\u65E5\u6D6A\u6F2B\u857E\u5662\u96F6\u8389\u9171\u5B98\u5B9D\u54EA\u4F4D\u7537\u670B\u53CB\u65F6\u600E\u4E48\u518D\u7ED9\u5531\u9996\u6B4C\u5427\u6293\u7D27\u266B\u53D4\u5BF9\u7EC8\u4E8E\u90A3\u966A\u7EE7\u52AA\u529B\u5317\u4EAC\u5916\u5339\u9ED1\u9A6C\u7136\u8FD8\u5237\u4E09\u65E9\u5B89\u751F\u804A\u5238\u4EC5\u5DE5\u94B1\u642D\u8FDB\u53BB\u501F\u989D\u7F51\u8D37\u8FDC\u554A\u6076\u6B7B\u5949\u6B21\u56DE\u731D\u524D\u6539\u53D8\u5207\u4EC0\u5C45\u79CD\u6240\u72C2\u4E89\u5979\u79D8\u4F4E\u8BED\u5982\u6216\u7518\u5171\u540C\u654C\u6CB9\u9009\u8D8A\u7A33\u5B9A\u8D70\u5E95\u80C6\u7CFB\u5F03\u5FD8\u6389\u666F\u56FE\u7F6E\u7075\u91CF\u5FAA\u73AF\u9891\u7247\u6BB5\u6DFB\u5C4F\u5E55\u5DE6\u90E8\u7EFF\u6587\u6807\u7B7E\u53F3\u4FA7\u84DD\u79FB\u6C34\u8F6C\u5411\u6377\u62E9\u5EFA\u9879\u65B9\u9690\u85CF\u5E76\u4ECE\u573A\u9664\u505C\u6B62\u6DE1\u5165\u900F\u660E\u6309\u4F4F\u9F20\u7A7A\u75AF\u5BA2\u6280\u5389\u5BB3\u62C5\u95EE\u9898\u529E\u51C6\u5907\u8BD5\u7740\u627E\u94AE\u544A\u8BC9\u7A81\u83B7\u9700\u5C82\u968F\u7406\u767D\u5C0A\u561F\u5047\u65E2\u5E72\u8106\u63A5\u5C3D\u6C42\u603B\u5567\u56E0\u88AB\u867D\u65E0\u4EA1\u539F\u4ED6\u4E07\u4EBF\u800C\u4E14\u7B97\u4EF6\u5E2E\u80AF\u575A\u593A\u6743\u5177\u8BB2\u5B83\u76F8\u8F7B\u677E\u5730\u80DC\u6FC0\u7EDF\u6F0F\u6D1E\u672A\u79D1\u8BE6\u7EC6\u5C11\u7BA1\u914D\u5149\u60CA\u559C\u9A97\u4FE1\u7531\u51B3\u5219\u7ED5\u53E3\u4EE4\u6307\u53F9\u6536\u76CA\u5FC5\u91CA\u8111\u6982\u89E6\u4E58\u5176\u8C13\u50BB\u5B8C\u5931\u963F\u74E6\u55E6\u9EBB\u9E2D\u575B\u6749\u9B54\u4ED9\u5821\u7EC3\u4E60\u5370\u6591\u9E20\u6885\u5DDD\u9177\u5343\u65A4\u59D0\u9152\u9A7E\u8774\u8776\u654F\u8D39\u7FA4\u87F9\u9EC4\u62D6\u62C9\u59EC\u54A4\u85D5\u5DF4\u91CE\u6ED1\u7A3D\u83CC\u7F8A\u6751\u7F57\u5BC6\u6B27\u4E0E\u732A\u591C\u5435\u80C3\u56FD\u9000\u5802\u9F13\u8868\u62E8\u94F2\u5C4E\u519B\u5948\u4F55\u6865\u6446\u644A\u30BD\u5B66\u76D0\u7117\u7389\u74DC\u7687\u752B\u67F1\u7EAF\u865A\u6784\u7738\u9E21\u98DE\u72D7\u8DF3\u6797\u54C1\u8863\u5382\u5439\u88D9\u9732\u79CB\u88E4\u6015\u843D\u6BDB\u4E4C\u9F9F\u732B\u961F\u6478\u9C7C\u5178\u590D\u76AE\u56CA\u9B42\u66FF\u9694\u58C1\u996E\u6599\u5F39\u604B\u5305\u5C9B\u8089\u6C40\u54C8\u8BAE\u8D76\u5B57\u5947\u602A\u6D53\u4E11"
